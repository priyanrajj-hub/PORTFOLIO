# Primary Gemini API Key for J.A.R.V.I.S. AI Chat & Speech Synthesis (Server-Side Only)
# Configure this in your Vercel Project Settings > Environment Variables:
GEMINI_API_KEY=your_gemini_api_key_here

# (Optional) ElevenLabs API Key for High-Fidelity Stock Voice TTS
# If omitted, system defaults to Google Cloud / Gemini TTS
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# (Optional) Custom ElevenLabs Licensed Stock Voice IDs
# J.A.R.V.I.S. Classic (Default: "George" - British refined male voice: JBFqnCBsd6RMkjVDRZzb)
VOICE_ID_JARVIS=JBFqnCBsd6RMkjVDRZzb

# Sōsuke Mode (Default: "Brian" - deep, calm, measured male voice: nPczCjzI2devNBz1zQrb)
VOICE_ID_SOSUKE=nPczCjzI2devNBz1zQrb
